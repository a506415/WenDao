  <!-- ===== Hediff ===== -->
  <HediffDef>
    <defName>WD_QiGathering</defName>
    <label>qi gathering</label>
    <description>An elixir draws spirit qi into the meridians, speeding up cultivation.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.85, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <!-- 嚴重度 = 品質倍率：加成 30% × 嚴重度 -->
        <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
        <statFactors>
          <WD_CultivationSpeed>1.3</WD_CultivationSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>WD_FoundationAid</defName>
    <label>foundation pill</label>
    <description>The power of a foundation pill lingers, raising the chance of breaking through to Foundation Establishment. It is used up by the attempt.</description>
    <hediffClass>WenDao.Hediff_BreakthroughAid</hediffClass>
    <defaultLabelColor>(1.0, 0.85, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <modExtensions>
      <li Class="WenDao.BreakthroughAidExtension">
        <realm>WD_QiRefining</realm>
      </li>
    </modExtensions>
  </HediffDef>

