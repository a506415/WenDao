  <!-- ===== 丹爐 ===== -->
  <ThingDef ParentName="BenchBase">
    <defName>WD_AlchemyFurnace</defName>
    <label>alchemy furnace</label>
    <description>A wood-fired furnace for refining elixirs. Only cultivators can control its flame. Advanced elixirs may make it explode.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <!-- 佔位貼圖：原版發酵桶 -->
      <texPath>Things/Building/Production/FermentingBarrel</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <costStuffCount>100</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.45</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <designationCategory>WD_Cultivation</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>40</fuelConsumptionRate>
        <fuelCapacity>50</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <WorkTypeDef>
    <defName>WD_Alchemy</defName>
    <labelShort>alchemy</labelShort>
    <pawnLabel>alchemist</pawnLabel>
    <gerundLabel>refining elixirs</gerundLabel>
    <description>Refine elixirs at an alchemy furnace. Only cultivators can do this work.</description>
    <verb>Refine elixirs</verb>
    <naturalPriority>480</naturalPriority>
    <relevantSkills>
      <li>Medicine</li>
      <li>Intellectual</li>
    </relevantSkills>
    <workTags>
      <li>Intellectual</li>
      <li>AllWork</li>
    </workTags>
  </WorkTypeDef>

  <WorkGiverDef>
    <defName>WD_DoBillsAlchemy</defName>
    <label>refine elixirs</label>
    <giverClass>WenDao.WorkGiver_Alchemy</giverClass>
    <workType>WD_Alchemy</workType>
    <priorityInType>100</priorityInType>
    <fixedBillGiverDefs>
      <li>WD_AlchemyFurnace</li>
    </fixedBillGiverDefs>
    <verb>refine elixirs at</verb>
    <gerund>refining elixirs at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>

