<Defs>

  <!-- ===== 靈植（貼圖為原版改色佔位）===== -->
  <ThingDef ParentName="PlantBase">
    <defName>WD_Plant_SpiritHerb</defName>
    <label>spirit herb</label>
    <description>A common herb that feeds on spirit qi. It grows faster where qi is dense. Used in alchemy.</description>
    <thingClass>WenDao.Plant_Spirit</thingClass>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Astragalus</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <color>(0.6,0.9,1)</color>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <growDays>6</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <harvestWork>300</harvestWork>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>WD_SpiritHerb</harvestedThingDef>
      <harvestYield>4</harvestYield>
      <sowWork>400</sowWork>
      <sowMinSkill>4</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <purpose>Health</purpose>
      <topWindExposure>0.1</topWindExposure>
      <visualSizeRange>0.4~0.9</visualSizeRange>
      <wildOrder>2</wildOrder>
    </plant>
    <modExtensions>
      <li Class="WenDao.SpiritPlantExtension">
        <minQi>0</minQi>
      </li>
    </modExtensions>
  </ThingDef>

