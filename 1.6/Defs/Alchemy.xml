  <ThingDef ParentName="WD_ElixirBase">
    <defName>WD_QiGatheringPill</defName>
    <label>qi-gathering pill</label>
    <description>Speeds up cultivation for about a day. Better quality gives a bigger boost.</description>
    <graphicData>
      <texPath>Things/Item/Drug/Penoxycyline</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.6,0.85,1)</color>
    </graphicData>
    <statBases>
      <MarketValue>40</MarketValue>
    </statBases>
    <ingestible>
      <outcomeDoers>
        <li Class="WenDao.IngestionOutcomeDoer_ElixirHediff">
          <hediff>WD_QiGathering</hediff>
          <durationTicks>60000</durationTicks>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Drug">
