<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===== 數值總表（集中調整）===== -->
  <WenDao.WenDaoTuningDef>
    <defName>WD_Tuning</defName>

    <!-- 修為增量/小時 = baseGainPerHour × 修煉速度(靈根×心境…) × 該格靈氣 × 打坐處效率 -->
    <baseGainPerHour>1.0</baseGainPerHour>
    <groundEfficiency>0.6</groundEfficiency>
    <sessionTicks>5000</sessionTicks>

    <!-- 天地靈氣 -->
    <mapBaseQi>0.7~1.3</mapBaseQi>
    <qiNoiseAmplitude>0.35</qiNoiseAmplitude>
    <qiNoiseFrequency>0.04</qiNoiseFrequency>
    <minQi>0.05</minQi>
    <!-- 每名打坐者每小時抽走半徑內每格的靈氣；回復為每小時補回(基準-現值)的比例。
         平衡時：濃度 ≈ 基準 − 人數 × drain / regen -->
    <qiDrainPerHour>0.01</qiDrainPerHour>
    <qiDrainRadius>2.9</qiDrainRadius>
    <qiRegenFractionPerHour>0.1</qiRegenFractionPerHour>

    <!-- 真元：每天自然回復上限的比例 × 該格靈氣；打坐時乘以倍率 -->
    <zhenyuanRegenPerDay>1.0</zhenyuanRegenPerDay>
    <zhenyuanCultivatingFactor>3</zhenyuanCultivatingFactor>

    <!-- 突破：成功率 = 境界基礎成功率 × 強行係數 + 護法加成，夾在 breakthroughChanceRange。
         強行係數 = Lerp(forcedChanceMin, 1, 感悟比例)；強行且成功仍折壽新境界壽元上限的 forcedLifespanCapFraction。
         護法加成 = guardBonus × 閉關期間有護法在 guardRadius 內的時間比例。 -->
    <forcedChanceMin>0.3</forcedChanceMin>
    <forcedLifespanCapFraction>0.1</forcedLifespanCapFraction>
    <guardBonus>0.15</guardBonus>
    <guardRadius>3.9</guardRadius>
    <breakthroughChanceRange>0.02~0.95</breakthroughChanceRange>

    <!-- 天劫：預警後開始，每隔一段時間一道雷；雷直接劈中突破者（無視護甲、不引火），並波及 tribulationSplashRadius 內的其他人。 -->
    <tribulationWarningTicks>2500</tribulationWarningTicks>
    <tribulationIntervalTicks>600</tribulationIntervalTicks>
    <tribulationSplashRadius>2.9</tribulationSplashRadius>

    <!-- 壽元：剩餘少於此年數時發警告信（應大於單次突破失敗的最大折壽，否則可能來不及警告） -->
    <lifespanWarningYears>15</lifespanWarningYears>

    <!-- 法術：屬性相合加成 = spellElementBonus ÷ 靈根屬性數；燃血期間威力倍率；非徵召時受傷後多久內會自動防禦。 -->
    <spellElementBonus>0.5</spellElementBonus>
    <bloodBurningSpellPower>1.5</bloodBurningSpellPower>
    <autoDefendWindowTicks>120</autoDefendWindowTicks>
  </WenDao.WenDaoTuningDef>

  <!-- ===== 境界 =====
       stageCosts：每個小階需要的修為。頭級資質（約 ×2）每天打坐 8 小時約 +16。
       練氣 360 ≈ 3 週；築基 850 ≈ 1 年；金丹 2300 ≈ 2.4 年。 -->

  <WenDao.CultivationRealmDef>
    <defName>WD_QiRefining</defName>
    <label>Qi Refining</label>
    <order>1</order>
    <zhenyuanMax>20</zhenyuanMax>
    <lifespanYears>120</lifespanYears>
    <!-- 突破出此境界（→ 築基） -->
    <insightRequired>60</insightRequired>
    <seclusionDays>1</seclusionDays>
    <breakthroughChance>0.75</breakthroughChance>
    <failureLifespanLoss>1~3</failureLifespanLoss>
    <failureHediffs>
      <li>
        <hediff>WD_QiBacklash</hediff>
        <severity>0.35</severity>
      </li>
    </failureHediffs>
    <stageLabels>
      <li>layer 1</li>
      <li>layer 2</li>
      <li>layer 3</li>
      <li>layer 4</li>
      <li>layer 5</li>
      <li>layer 6</li>
      <li>layer 7</li>
      <li>layer 8</li>
      <li>layer 9</li>
    </stageLabels>
    <stageCosts>
      <li>20</li>
      <li>25</li>
      <li>30</li>
      <li>35</li>
      <li>40</li>
      <li>45</li>
      <li>50</li>
      <li>55</li>
      <li>60</li>
    </stageCosts>
  </WenDao.CultivationRealmDef>

  <WenDao.CultivationRealmDef>
    <defName>WD_FoundationEstablishment</defName>
    <label>Foundation Establishment</label>
    <order>2</order>
    <zhenyuanMax>60</zhenyuanMax>
    <spellPower>1.5</spellPower>
    <lifespanYears>200</lifespanYears>
    <!-- 突破出此境界（→ 金丹） -->
    <insightRequired>250</insightRequired>
    <seclusionDays>2</seclusionDays>
    <breakthroughChance>0.55</breakthroughChance>
    <failureLifespanLoss>5~10</failureLifespanLoss>
    <failureHediffs>
      <li>
        <hediff>WD_QiBacklash</hediff>
        <severity>0.6</severity>
      </li>
      <li>
        <hediff>WD_DamagedFoundation</hediff>
        <severity>1</severity>
      </li>
    </failureHediffs>
    <stageLabels>
      <li>early</li>
      <li>middle</li>
      <li>late</li>
      <li>perfected</li>
    </stageLabels>
    <stageCosts>
      <li>180</li>
      <li>200</li>
      <li>220</li>
      <li>250</li>
    </stageCosts>
  </WenDao.CultivationRealmDef>

  <WenDao.CultivationRealmDef>
    <defName>WD_GoldenCore</defName>
    <label>Golden Core</label>
    <order>3</order>
    <zhenyuanMax>150</zhenyuanMax>
    <spellPower>2.2</spellPower>
    <lifespanYears>400</lifespanYears>
    <!-- 突破進此境界要渡天劫 -->
    <tribulationStrikes>9</tribulationStrikes>
    <tribulationDamage>5~8</tribulationDamage>
    <!-- 突破出金丹（→ 元嬰）屬 Phase 3：走火入魔、境界跌落、折壽 20–50 年 -->
    <stageLabels>
      <li>early</li>
      <li>middle</li>
      <li>late</li>
      <li>perfected</li>
    </stageLabels>
    <stageCosts>
      <li>500</li>
      <li>550</li>
      <li>600</li>
      <li>650</li>
    </stageCosts>
  </WenDao.CultivationRealmDef>

  <!-- ===== 修為 Hediff ===== -->
  <HediffDef>
    <defName>WD_Cultivation</defName>
    <hediffClass>WenDao.Hediff_Cultivation</hediffClass>
    <label>cultivation</label>
    <description>This person's cultivation realm and progress.</description>
    <defaultLabelColor>(0.95, 0.85, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <!-- 有修為才有真元 -->
        <enablesNeeds>
          <li>WD_Zhenyuan</li>
        </enablesNeeds>
      </li>
    </stages>
  </HediffDef>

  <!-- ===== 真元 ===== -->
  <NeedDef>
    <defName>WD_Zhenyuan</defName>
    <needClass>WenDao.Need_Zhenyuan</needClass>
    <label>true essence</label>
    <description>The cultivator's reservoir of refined spiritual energy, spent on spells and protective qi. It recovers on its own from the surrounding spirit qi, much faster while cultivating. Its capacity grows with the cultivation realm.</description>
    <minIntelligence>Humanlike</minIntelligence>
    <onlyIfCausedByHediff>true</onlyIfCausedByHediff>
    <listPriority>700</listPriority>
    <showForCaravanMembers>true</showForCaravanMembers>
  </NeedDef>

  <!-- ===== 修煉速度 Stat：丹藥、功法日後以 statFactors 疊上 ===== -->
  <StatDef>
    <defName>WD_CultivationSpeed</defName>
    <label>cultivation speed</label>
    <description>How fast this person gains cultivation progress, before the local spirit qi and the meditation spot are applied.</description>
    <category>BasicsPawn</category>
    <workerClass>WenDao.StatWorker_CultivationSpeed</workerClass>
    <defaultBaseValue>1</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <showOnAnimals>false</showOnAnimals>
    <showOnMechanoids>false</showOnMechanoids>
    <displayPriorityInCategory>3000</displayPriorityInCategory>
    <parts>
      <li Class="WenDao.StatPart_SpiritRoot" />
      <li Class="WenDao.StatPart_MindState">
        <!-- 心境係數：心情 0 → ×0.6，0.5 → ×1.0，1 → ×1.2 -->
        <curve>
          <points>
            <li>(0, 0.6)</li>
            <li>(0.5, 1.0)</li>
            <li>(1, 1.2)</li>
          </points>
        </curve>
      </li>
    </parts>
  </StatDef>

</Defs>
