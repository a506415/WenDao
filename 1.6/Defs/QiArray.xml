<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===== 靈石（打坐消耗與通貨用途屬 Phase 2）===== -->
  <ThingDef ParentName="ResourceBase">
    <defName>WD_SpiritStone</defName>
    <label>spirit stone</label>
    <description>A crystal that has soaked up spirit qi over ages. It powers formations.</description>
    <graphicData>
      <!-- 佔位貼圖：原版翡翠 -->
      <texPath>Things/Item/Resource/Jade</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.55, 0.85, 1.0)</color>
    </graphicData>
    <stackLimit>75</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <statBases>
      <MarketValue>8</MarketValue>
      <Mass>0.1</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <deepCommonality>0.5</deepCommonality>
    <deepCountPerPortion>15</deepCountPerPortion>
    <deepLumpSizeRange>1~4</deepLumpSizeRange>
  </ThingDef>

  <ThingDef ParentName="RockBase">
    <defName>WD_MineableSpiritStone</defName>
    <label>spirit stone vein</label>
    <description>Rock veined with spirit stone.</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(68,78,88)</color>
      <colorTwo>(120,210,255)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>WD_SpiritStone</mineableThing>
      <mineableYield>20</mineableYield>
      <mineableScatterCommonality>0.2</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>3~8</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
  </ThingDef>

  <!-- ===== 聚靈陣 ===== -->
  <ThingDef ParentName="BuildingBase">
    <defName>WD_QiGatheringArray</defName>
    <label>qi-gathering array</label>
    <description>The eye of a formation that draws spirit qi into the surrounding area. A cultivator must lay the formation after it is built or moved, and it runs on spirit stones. Overlapping arrays do not stack; the strongest applies.</description>
    <graphicData>
      <!-- 佔位貼圖：原版空投信標 -->
      <texPath>Things/Building/Misc/DropBeacon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.6, 0.85, 1.0)</color>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.3</fillPercent>
    <rotatable>false</rotatable>
    <specialDisplayRadius>5.9</specialDisplayRadius>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <costList>
      <WD_SpiritStone>15</WD_SpiritStone>
    </costList>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <building>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2</fuelConsumptionRate>
        <fuelCapacity>30</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WD_SpiritStone</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="WenDao.CompProperties_QiArray">
        <radius>5.9</radius>
        <setupTicks>2500</setupTicks>
      </li>
    </comps>
    <placeWorkers>
      <li>WenDao.PlaceWorker_ShowSpiritQi</li>
    </placeWorkers>
    <designationCategory>WD_Cultivation</designationCategory>
  </ThingDef>

  <JobDef>
    <defName>WD_SetupArray</defName>
    <driverClass>WenDao.JobDriver_SetupArray</driverClass>
    <reportString>laying the formation of TargetA.</reportString>
  </JobDef>

</Defs>
